! r3 baseline - generated by scripts/build_baseline.py from netlab node_files
! --- initial
hostname r3
!
logging monitor debugging
aaa authorization exec default local
!
lldp run
ip routing
no ipv6 unicast-routing
!
!
ip host client 10.10.10.10
ip host r1 10.0.0.1 10.255.0.1 10.255.0.5 10.10.10.1
ip host r2 10.0.0.2 10.255.0.2 10.255.0.9
ip host r4 10.0.0.4 10.255.0.10 10.255.0.14 10.20.20.1
ip host service 10.20.20.20
!
interface Management0
 no lldp transmit
 no lldp receive
!
interface Loopback0
 ip address 10.0.0.3/32
!
interface Ethernet1
 no switchport
 description r3 -> r1 [external]
 ip address 10.255.0.6/30
 mac-address caf0.0003.0001
!
 no shutdown
!
interface Ethernet2
 no switchport
 description r3 -> r4 [external]
 ip address 10.255.0.13/30
 mac-address caf0.0003.0002
!
 no shutdown
!

! --- bgp
!
!
router bgp 65003
  bgp advertise-inactive
  bgp log-neighbor-changes
  no bgp default ipv4-unicast
  no bgp default ipv6-unicast
  router-id 10.0.0.3
!
  neighbor 10.255.0.5 remote-as 65001
  neighbor 10.255.0.5 description r1
  neighbor 10.255.0.5 send-community standard large
!
  neighbor 10.255.0.14 remote-as 65004
  neighbor 10.255.0.14 description r4
  neighbor 10.255.0.14 send-community standard large
!
!
 address-family ipv4

!
!
  neighbor 10.255.0.5 activate
  neighbor 10.255.0.5 next-hop-self
  neighbor 10.255.0.14 activate
  neighbor 10.255.0.14 next-hop-self

! --- no data-plane default via the management bridge
no ip route 0.0.0.0/0 192.168.121.1
