! r1 baseline - generated by scripts/build_baseline.py from netlab node_files
! --- initial
hostname r1
!
logging monitor debugging
aaa authorization exec default local
!
lldp run
ip routing
no ipv6 unicast-routing
!
!
ip host client 10.10.10.10
ip host r2 10.0.0.2 10.255.0.2 10.255.0.9
ip host r3 10.0.0.3 10.255.0.6 10.255.0.13
ip host r4 10.0.0.4 10.255.0.10 10.255.0.14 10.20.20.1
ip host service 10.20.20.20
!
interface Management0
 no lldp transmit
 no lldp receive
!
interface Loopback0
 ip address 10.0.0.1/32
!
interface Ethernet1
 no switchport
 description r1 -> r2 [external]
 ip address 10.255.0.1/30
 mac-address caf0.0001.0001
!
 no shutdown
!
interface Ethernet2
 no switchport
 description r1 -> r3 [external]
 ip address 10.255.0.5/30
 mac-address caf0.0001.0002
!
 no shutdown
!
interface Ethernet3
 no switchport
 description r1 -> client [stub]
 ip address 10.10.10.1/24
 mac-address caf0.0001.0003
!
 no shutdown
!

! --- routing
!
!
route-map bp-r2-1-in-ipv4 permit 10
  set local-preference 200

! --- bgp
!
!
router bgp 65001
  bgp advertise-inactive
  bgp log-neighbor-changes
  no bgp default ipv4-unicast
  no bgp default ipv6-unicast
  router-id 10.0.0.1
!
  neighbor 10.255.0.2 remote-as 65002
  neighbor 10.255.0.2 description r2
  neighbor 10.255.0.2 send-community standard large
!
  neighbor 10.255.0.6 remote-as 65003
  neighbor 10.255.0.6 description r3
  neighbor 10.255.0.6 send-community standard large
!
!
 address-family ipv4

!
  network 10.10.10.0/24
!
  neighbor 10.255.0.2 activate
  neighbor 10.255.0.2 next-hop-self
  neighbor 10.255.0.6 activate
  neighbor 10.255.0.6 next-hop-self

! --- bgp.policy
!
!
router bgp 65001
!
 address-family ipv4

    neighbor 10.255.0.2 route-map bp-r2-1-in-ipv4 in

! --- no data-plane default via the management bridge
no ip route 0.0.0.0/0 192.168.121.1
! --- workshop policy
!
ip access-list CLIENT-IN
   10 permit tcp host 10.10.10.10 host 10.20.20.20 eq 8080
   20 deny tcp host 10.10.10.10 host 10.20.20.20 eq 2222
   30 permit icmp any any
   40 deny ip any any
!
interface Ethernet3
   ip access-group CLIENT-IN in
!
