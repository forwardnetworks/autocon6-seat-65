! r2 baseline - generated by scripts/build_baseline.py from netlab node_files
! --- initial
hostname r2
!
logging monitor debugging
aaa authorization exec default local
!
lldp run
ip routing
no ipv6 unicast-routing
!
!
ip host client 10.10.10.10
ip host r1 10.0.0.1 10.255.0.1 10.255.0.5 10.10.10.1
ip host r3 10.0.0.3 10.255.0.6 10.255.0.13
ip host r4 10.0.0.4 10.255.0.10 10.255.0.14 10.20.20.1
ip host service 10.20.20.20
!
interface Management0
 no lldp transmit
 no lldp receive
!
interface Loopback0
 ip address 10.0.0.2/32
!
interface Ethernet1
 no switchport
 description r2 -> r1 [external]
 ip address 10.255.0.2/30
 mac-address caf0.0002.0001
!
 no shutdown
!
interface Ethernet2
 no switchport
 description r2 -> r4 [external]
 ip address 10.255.0.9/30
 mac-address caf0.0002.0002
!
 no shutdown
!

! --- bgp
!
!
router bgp 65002
  bgp advertise-inactive
  bgp log-neighbor-changes
  no bgp default ipv4-unicast
  no bgp default ipv6-unicast
  router-id 10.0.0.2
!
  neighbor 10.255.0.1 remote-as 65001
  neighbor 10.255.0.1 description r1
  neighbor 10.255.0.1 send-community standard large
!
  neighbor 10.255.0.10 remote-as 65004
  neighbor 10.255.0.10 description r4
  neighbor 10.255.0.10 send-community standard large
!
!
 address-family ipv4

!
!
  neighbor 10.255.0.1 activate
  neighbor 10.255.0.1 next-hop-self
  neighbor 10.255.0.10 activate
  neighbor 10.255.0.10 next-hop-self

! --- no data-plane default via the management bridge
no ip route 0.0.0.0/0 192.168.121.1
