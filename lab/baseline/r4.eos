! r4 baseline - generated by scripts/build_baseline.py from netlab node_files
! --- initial
hostname r4
!
logging monitor debugging
aaa authorization exec default local
!
lldp run
ip routing
no ipv6 unicast-routing
!
!
ip host client 10.10.10.10
ip host r1 10.0.0.1 10.255.0.1 10.255.0.5 10.10.10.1
ip host r2 10.0.0.2 10.255.0.2 10.255.0.9
ip host r3 10.0.0.3 10.255.0.6 10.255.0.13
ip host service 10.20.20.20
!
interface Management0
 no lldp transmit
 no lldp receive
!
interface Loopback0
 ip address 10.0.0.4/32
!
interface Ethernet1
 no switchport
 description r4 -> r2 [external]
 ip address 10.255.0.10/30
 mac-address caf0.0004.0001
!
 no shutdown
!
interface Ethernet2
 no switchport
 description r4 -> r3 [external]
 ip address 10.255.0.14/30
 mac-address caf0.0004.0002
!
 no shutdown
!
interface Ethernet3
 no switchport
 description r4 -> service [stub]
 ip address 10.20.20.1/24
 mac-address caf0.0004.0003
!
 no shutdown
!

! --- routing
!
!
route-map bp-r2-1-in-ipv4 permit 10
  set local-preference 200

! --- bgp
!
!
router bgp 65004
  bgp advertise-inactive
  bgp log-neighbor-changes
  no bgp default ipv4-unicast
  no bgp default ipv6-unicast
  router-id 10.0.0.4
!
  neighbor 10.255.0.9 remote-as 65002
  neighbor 10.255.0.9 description r2
  neighbor 10.255.0.9 send-community standard large
!
  neighbor 10.255.0.13 remote-as 65003
  neighbor 10.255.0.13 description r3
  neighbor 10.255.0.13 send-community standard large
!
!
 address-family ipv4

!
  network 10.20.20.0/24
!
  neighbor 10.255.0.9 activate
  neighbor 10.255.0.9 next-hop-self
  neighbor 10.255.0.13 activate
  neighbor 10.255.0.13 next-hop-self

! --- bgp.policy
!
!
router bgp 65004
!
 address-family ipv4

    neighbor 10.255.0.9 route-map bp-r2-1-in-ipv4 in

! --- no data-plane default via the management bridge
no ip route 0.0.0.0/0 192.168.121.1
! --- workshop scenario: stale advertisements
!
router bgp 65004
   address-family ipv4
      network 10.20.30.0/24
      network 10.20.40.0/24
!
